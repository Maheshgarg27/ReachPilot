{
    "manifest_version": 3,
    "name": "ReachPilot",
    "version": "1.0.0",
    "description": "AI-powered LinkedIn outreach assistant",

    "permissions": [
        "storage",
        "activeTab"
    ],

    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "https://www.linkedin.com/*"
    ],

    "action": {
        "default_popup": "popup.html",
        "default_title": "ReachPilot"
    },

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}